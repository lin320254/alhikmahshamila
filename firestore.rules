rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'createdAt', 'lastLoginAt']) &&
        data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is timestamp && data.lastLoginAt <= request.time));
    }

    function isValidUserBook(data, userId, bookId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'url', 'isFavorite', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'author', 'category', 'url', 'notes', 'isFavorite', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == bookId &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        (!('author' in data) || (data.author is string && data.author.size() <= 200)) &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
        data.url is string && data.url.size() > 0 && data.url.size() <= 1000 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        data.isFavorite is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      match /books/{bookId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserBook(request.resource.data, userId, bookId);
        allow update: if isOwner(userId) && isValidUserBook(request.resource.data, userId, bookId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
